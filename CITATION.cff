    given-names: "W. Keith"
    orcid: "https://orcid.org/0000-0002-2522-6167"
repository-code: "https://github.com/bganglmair/patccatClaims"
license: MIT
date-released: "2026-09-10"
keywords:
  - patents
  - patent claims
  - text classification
  - part-of-speech tagging
  - R
